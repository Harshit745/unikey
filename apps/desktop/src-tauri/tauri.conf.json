{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniKey",
  "mainBinaryName": "UniKey",
  "version": "0.1.0",
  "identifier": "dev.unikey.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UniKey",
        "width": 1000,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "targets": "all",
    "category": "Utility",
    "shortDescription": "One keyboard, one clipboard, one workspace across every device.",
    "longDescription": "UniKey shares your keyboard, mouse, clipboard and files seamlessly across every device on your local network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
